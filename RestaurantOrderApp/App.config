<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="RestaurantDb"
             connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=RestaurantDB;Integrated Security=True;TrustServerCertificate=True;"
             providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="DiscountPercent" value="10"/>
		<add key="MinOrderForFreeDelivery" value="200"/>
		<add key="StandardDeliveryFee" value="15"/>
		<add key="ReducedDeliveryFee" value="0"/>
		<add key="DiscountValueThreshold" value="200"/>
		<add key="DiscountOrdersCountThreshold" value="3"/>
		<add key="DiscountDaysThreshold" value="30"/>
		<add key="CriticalStockThreshold" value="5" />
	</appSettings>
	
</configuration>