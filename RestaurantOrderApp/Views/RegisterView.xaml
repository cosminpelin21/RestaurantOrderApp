<Window x:Class="RestaurantOrderApp.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RestaurantOrderApp.Helpers"
        Title="Teatris - Create Account" 
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#121212" KeyDown="Window_KeyDown">

    <Window.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Grid>
        <TextBlock Text="T" FontSize="500" Foreground="#0AFFFFFF" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                <TextBlock Text="BECOME A MEMBER" FontSize="28" FontFamily="Georgia" 
                           Foreground="#D4AF37" HorizontalAlignment="Center"/>
                <Rectangle Height="1" Fill="#33D4AF37" Margin="0,15,0,30" Width="200"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="FIRST NAME" Foreground="#888" FontSize="10" Margin="5,0"/>
                        <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,20">
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="LAST NAME" Foreground="#888" FontSize="10" Margin="5,0"/>
                        <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,20">
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="EMAIL ADDRESS" Foreground="#888" FontSize="10" Margin="5,0"/>
                <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,20">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <TextBlock Text="PHONE NUMBER" Foreground="#888" FontSize="10" Margin="5,0"/>
                <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,20">
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <TextBlock Text="DELIVERY ADDRESS" Foreground="#888" FontSize="10" Margin="5,0"/>
                <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,20">
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <TextBlock Text="CHOOSE PASSWORD" Foreground="#888" FontSize="10" Margin="5,0"/>
                <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,30">
                    <PasswordBox x:Name="PassBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF6B6B" FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

                <Button Content="CREATE ACCOUNT" 
                        Command="{Binding RegisterCommand}" 
                        CommandParameter="{Binding ElementName=PassBox}"
                        IsDefault="True" Height="50" Background="#D4AF37" Foreground="Black" 
                        FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>

                <Button Content="BACK TO LOGIN" Click="BackToLogin_Click" Margin="0,15,0,0"
                        Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>