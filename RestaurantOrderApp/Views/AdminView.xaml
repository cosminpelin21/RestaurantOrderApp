<Window x:Class="RestaurantOrderApp.Views.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teatris - Admin Dashboard" WindowState="Maximized" 
        Background="#121212" WindowStyle="None">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="STAFF DASHBOARD" Foreground="#D4AF37" FontSize="36" 
                       FontFamily="Georgia" HorizontalAlignment="Center" Margin="0,0,0,50"/>

            <Button Content="ORDER MANAGEMENT" Click="GoToOrders_Click" 
                    Height="60" Margin="0,10" Background="#1A1A1A" Foreground="White" 
                    BorderBrush="#33D4AF37" BorderThickness="1" Cursor="Hand" FontWeight="Bold"/>

            <Button Content="PRODUCT MANAGEMENT &amp; STOCK" Click="GoToProducts_Click" 
                    Height="60" Margin="0,10" Background="#1A1A1A" Foreground="White" 
                    BorderBrush="#33D4AF37" BorderThickness="1" Cursor="Hand" FontWeight="Bold"/>

            <Button Content="CRITICAL STOCK REPORTS" Click="GoToReports_Click" 
                    Height="60" Margin="0,10" Background="#1A1A1A" Foreground="#D4AF37" 
                    BorderBrush="#D4AF37" BorderThickness="1" Cursor="Hand" FontWeight="Bold"/>

            <Separator Background="#333" Margin="0,30"/>

            <Button Content="LOGOUT" Click="Logout_Click" 
                    Background="Transparent" Foreground="#666" BorderThickness="0" 
                    Cursor="Hand" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>