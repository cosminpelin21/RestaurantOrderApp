<Window x:Class="RestaurantOrderApp.Views.MyOrderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOrderApp.Views"
        mc:Ignorable="d"
        Title="Teatris - My Orders" Background="#121212"
        WindowState="Maximized" WindowStyle="None">
    <Grid Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ORDER HISTORY" FontSize="32" FontFamily="Georgia" 
                   Foreground="#D4AF37" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding UserOrders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33D4AF37" BorderThickness="1" Margin="0,0,0,20" Padding="20" Background="#1A1A1A">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding OrderDate, StringFormat='{}Date: {0:dd MMM yyyy HH:mm}'}" Foreground="#888" FontSize="12"/>
                                    <TextBlock Text="{Binding OrderCode, StringFormat='{}Order ID: {0}'}" Foreground="#555" FontSize="10" FontFamily="Consolas" Margin="0,2,0,5"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="ESTIMATED DELIVERY" Foreground="#555" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding EstimatedDeliveryTime, StringFormat='{}{0:HH:mm}'}" 
                                               Foreground="White" FontSize="18" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding OrderDetails}" Margin="0,15,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x '}" Foreground="#D4AF37" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Product.Name}" Foreground="White"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding TotalCost, StringFormat='{}Total: {0:N2} LEI'}" 
                                               Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" Content="CANCEL ORDER" 
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#FF4C4C" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="15,5" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="In asteptare">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="BACK TO MENU" Click="Back_Click" 
                HorizontalAlignment="Left" Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>
