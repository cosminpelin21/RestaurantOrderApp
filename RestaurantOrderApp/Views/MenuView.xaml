<Window x:Class="RestaurantOrderApp.Views.MenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestaurantOrderApp.ViewModels"
        Title="Teatris - Menu" 
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#121212" KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    

    <Grid Margin="40">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="THE MENU" FontSize="36" FontFamily="Georgia" Foreground="#D4AF37" HorizontalAlignment="Center"/>
            <Rectangle Height="1" Fill="#33D4AF37" Margin="0,10,0,0" Width="400"/>
        </StackPanel>
        <Button Content="MY ORDERS" 
        Click="OpenOrders_Click" 
        HorizontalAlignment="Right" 
        Margin="0,0,20,0"
        Background="Transparent" 
        Foreground="#D4AF37" 
        BorderBrush="#D4AF37" 
        Padding="10,5"
        Cursor="Hand"
        Visibility="{Binding IsUserLoggedIn, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="SEARCH BY NAME" Foreground="#666" FontSize="10" Margin="5,0,0,5" FontFamily="Georgia"/>
                <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                 Width="250" Height="35" VerticalContentAlignment="Center"
                 Background="#1A1A1A" Foreground="White" BorderThickness="0" Padding="10,0"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Text="ALLERGEN:" Foreground="#666" FontSize="10" FontFamily="Georgia" VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <ComboBox ItemsSource="{Binding AllergensList}" 
                  SelectedItem="{Binding SelectedSearchAllergen}" 
                  DisplayMemberPath="Name" 
                  Width="110" Height="25" Margin="0,0,10,0" Background="#1A1A1A" BorderThickness="0"/>

                    <CheckBox IsChecked="{Binding ExcludeAllergen}" 
                  Content="Free" Foreground="#888" FontSize="11" 
                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Command="{Binding ClearAllergenFilterCommand}" 
                Content="✕" ToolTip="Clear allergen filter" 
                Width="20" Height="20" 
                Background="Transparent" Foreground="#D4AF37" BorderBrush="#33D4AF37" 
                Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="CATEGORY" Foreground="#666" FontSize="10" Margin="5,0,0,5" FontFamily="Georgia"/>
                <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="2">
                    <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}" 
                          DisplayMemberPath="Name"
                          Width="200" Height="35" Background="#1A1A1A" Foreground="Black" BorderThickness="0"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="10,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" 
           Source="{Binding ImagePath}" 
           Width="80" Height="80" 
           Stretch="UniformToFill" 
           Margin="0,0,20,0"
           VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="22" Foreground="White" FontFamily="Georgia"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Category.Name}" FontSize="12" Foreground="#D4AF37" FontWeight="SemiBold"/>
                                            <TextBlock Text=" | " Foreground="#333" Margin="8,0"/>
                                            <TextBlock Text="{Binding PortionQuantity}" FontSize="12" Foreground="#888"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Ingredients}" FontSize="11" Foreground="#777" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="40"/>
                                        <TextBlock Text="{Binding AllergensList, StringFormat='Allergens: {0}'}" FontSize="10" FontStyle="Italic" Foreground="#D4AF37" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                        <TextBlock Text="UNAVAILABLE" Foreground="#FF4C4C" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" FontFamily="Georgia">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalQuantity}" Value="0.00">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0} LEI'}" FontSize="20" Foreground="#D4AF37" FontWeight="Light" VerticalAlignment="Center" Margin="30,0"/>

                                    <Button Grid.Column="3" Content="+" Width="40" Height="40" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="20"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressBar IsIndeterminate="True" Width="250" Height="2" VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Background="Transparent" Foreground="#D4AF37" BorderThickness="0"/>
        </Grid>
        <Border x:Name="NotificationToast" 
                Grid.Row="2" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Background="#D4AF37" 
                CornerRadius="2"
                Padding="30,10"
                Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVis}}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <Path Data="M1,7 L5,11 L14,1" 
                      Stroke="Black" 
                      StrokeThickness="2" 
                      VerticalAlignment="Center" 
                      Margin="0,0,15,0"/>

                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="Black" 
                           FontWeight="Bold" 
                           FontSize="14"
                           FontFamily="Georgia"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,30,0,0">
            <Button Content="BACK TO START" Click="Back_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#666" BorderThickness="0"/>
            <Button Content="VIEW SELECTION" Command="{Binding OpenCartCommand}" HorizontalAlignment="Right" Padding="20,10" Background="#D4AF37" Foreground="Black" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>