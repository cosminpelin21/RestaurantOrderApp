<Window x:Class="RestaurantOrderApp.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOrderApp.Views"
        mc:Ignorable="d"
        Title="Teatris - Analytics" WindowState="Maximized" Background="#121212">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BACKSTAGE ANALYTICS" FontSize="32" FontFamily="Georgia" 
                   Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <UniformGrid Grid.Row="1" Columns="2">

            <StackPanel Margin="10">
                <TextBlock Text="CRITICAL STOCK (Low Inventory)" Foreground="#D4AF37" FontSize="18" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding CriticalStock}" AutoGenerateColumns="False" 
                          Background="#1A1A1A" Foreground="Black" IsReadOnly="True" BorderThickness="1" BorderBrush="#33D4AF37">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Stock Left" Binding="{Binding TotalQuantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Margin="10">
                <TextBlock Text="TOP 5 BEST SELLERS" Foreground="#D4AF37" FontSize="18" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" 
                          Background="#1A1A1A" Foreground="Black" IsReadOnly="True" BorderThickness="1" BorderBrush="#33D4AF37">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Qty Sold" Binding="{Binding TotalSold}" Width="80"/>
                        <DataGridTextColumn Header="Total Revenue" Binding="{Binding TotalRevenue, StringFormat='{}{0:N2} LEI'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </UniformGrid>
    </Grid>
</Window>
