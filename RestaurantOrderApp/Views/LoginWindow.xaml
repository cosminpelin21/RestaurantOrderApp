<Window x:Class="RestaurantOrderApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RestaurantOrderApp.Helpers"
        Title="Teatris - Member Access" 
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#121212" KeyDown="Window_KeyDown">

    <Window.Resources>
        <helpers:StringToVisibilityConverter x:Key="MyStringToVisConverter" />
    </Window.Resources>
    <Grid>
        <TextBlock Text="T" FontSize="500" Foreground="#0AFFFFFF" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <TextBlock Text="MEMBER ACCESS" FontSize="28" FontFamily="Georgia" 
                       Foreground="#D4AF37" HorizontalAlignment="Center"/>
            <Rectangle Height="1" Fill="#33D4AF37" Margin="0,15,0,40" Width="200"/>

            <TextBlock Text="Email" Foreground="#888" FontSize="11" Margin="5,0"/>
            <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,25">
                <TextBox x:Name="TxtUsername" 
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" 
                         BorderThickness="0" FontSize="16" Padding="5" CaretBrush="#D4AF37"/>
            </Border>

            <TextBlock Text="Password" Foreground="#888" FontSize="11" Margin="5,0"/>
            <Border BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,5,0,40">
                <PasswordBox x:Name="TxtPassword" Background="Transparent" Foreground="White" 
                             BorderThickness="0" FontSize="16" Padding="5" CaretBrush="#D4AF37"/>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" 
           Foreground="#FF6B6B" 
           Visibility="{Binding StatusMessage, Converter={StaticResource MyStringToVisConverter}}"/>

            <Button Content="SIGN IN" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=TxtPassword}"
                    IsDefault="True"
                    Height="50" Background="#D4AF37" Foreground="Black" 
                    FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>

            <Button Content="RETURN TO START" Click="Back_Click" Margin="0,20,0,0"
                    Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>