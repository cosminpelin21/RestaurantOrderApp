<Window x:Class="RestaurantOrderApp.Views.CartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teatris - Your Selection" 
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#121212" KeyDown="Window_KeyDown">

    <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock Text="YOUR SELECTION" FontSize="32" FontFamily="Georgia" 
                       Foreground="#D4AF37" HorizontalAlignment="Center"/>
            <Rectangle Height="1" Fill="#33D4AF37" Margin="0,15,0,0" Width="300"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding GroupedItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Product.Name}" FontSize="18" Foreground="White" FontFamily="Georgia"/>

                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" 
                               Foreground="#888" VerticalAlignment="Center" Margin="20,0"/>

                                <TextBlock Grid.Column="2" Text="{Binding TotalItemPrice, StringFormat='{}{0} LEI'}" 
                               FontSize="18" Foreground="#AAA" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <Button Grid.Column="3" Content="✕" Margin="20,0,0,0"
                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent" Foreground="#D4AF37" BorderThickness="0" Cursor="Hand" FontSize="16"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,40,0,20" Padding="0,20,0,0" BorderBrush="#D4AF37" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Width="300">
                <Grid Margin="0,5">
                    <TextBlock Text="Subtotal" Foreground="#888"/>
                    <TextBlock Text="{Binding FoodCost, StringFormat='{}{0} LEI'}" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,5">
                    <TextBlock Text="Delivery Fee" Foreground="#888"/>
                    <TextBlock Text="{Binding DeliveryCost, StringFormat='{}{0} LEI'}" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
                <Rectangle Height="1" Fill="#33D4AF37" Margin="0,15"/>
                <Grid Margin="0,5">
                    <TextBlock Text="GRAND TOTAL" Foreground="#D4AF37" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalCost, StringFormat='{}{0:N2} LEI'}" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiscountAmount}" Value="0.00">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBlock Text="DISCOUNT APPLIED:" Foreground="#4CAF50" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DiscountAmount, StringFormat='-{0:N2} LEI'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Button Content="RETURN TO MENU" Click="Back_Click" HorizontalAlignment="Left" 
                    Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Press ESC to Exit" Foreground="#444" VerticalAlignment="Center" Margin="0,0,30,0" FontSize="11"/>
                <Button Content="CONFIRM ORDER" Command="{Binding DataContext.PlaceOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="40,15" Background="#D4AF37" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>