<Window x:Class="RestaurantOrderApp.Views.StaffOrdersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOrderApp.Views" xmlns:vm="clr-namespace:RestaurantOrderApp.ViewModels"
        mc:Ignorable="d"
        Title="Teatris - Backstage Management" WindowState="Maximized" Background="#121212">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ORDER MANAGEMENT" FontSize="32" FontFamily="Georgia" 
                   Foreground="#D4AF37" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding AllOrders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33D4AF37" BorderThickness="1" Margin="0,0,0,20" Padding="20" Background="#1A1A1A">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding OrderCode, StringFormat='{}Code: {0}'}" Foreground="#555" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='{}Date: {0:dd MMM yyyy HH:mm}'}" Foreground="#888" FontSize="13" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,5"/>
                                    <TextBlock Text="{Binding TotalCost, StringFormat='{}Total: {0:N2} LEI'}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>

                                <Border Grid.Row="0" Grid.Column="1" Background="#222" Padding="15" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOMER DETAILS" Foreground="#666" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding User.FirstName, StringFormat='{}Name: {0}'}" Foreground="White" FontSize="14"/>
                                        <TextBlock Text="{Binding User.Phone, StringFormat='{}Phone: {0}'}" Foreground="White" FontSize="14"/>
                                        <TextBlock Text="{Binding User.DeliveryAddress, StringFormat='{}Address: {0}'}" Foreground="#AAA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding OrderDetails}" Margin="0,15,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x '}" Foreground="#D4AF37" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Product.Name}" Foreground="#DDD"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

                                    <Button Content="START PREPARING" Background="#D4AF37" Foreground="Black" FontWeight="Bold" BorderThickness="0" Padding="15,8" Cursor="Hand" Margin="0,0,10,0"
                                            Command="{Binding DataContext.PrepareOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="MARK AS DELIVERED" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="15,8" Cursor="Hand" Margin="0,0,10,0"
                                            Command="{Binding DataContext.DeliverOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Preparing">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="CANCEL" Background="#FF4C4C" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="15,8" Cursor="Hand"
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="BACK TO DASHBOARD" Click="Back_Click" 
            Background="Transparent" Foreground="#666" BorderThickness="0" 
            Cursor="Hand" Margin="0,0,20,0"/>

            <Button Content="PRODUCT MANAGEMENT" Click="GoToProducts_Click" 
            Background="#D4AF37" Foreground="Black" FontWeight="Bold" 
            Padding="20,5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
