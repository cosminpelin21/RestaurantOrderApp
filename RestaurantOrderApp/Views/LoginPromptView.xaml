<Window x:Class="RestaurantOrderApp.Views.LoginPromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authentication Required" Height="300" Width="450"
        WindowStyle="None" WindowState="Normal" WindowStartupLocation="CenterScreen"
        Background="#1A1A1A" AllowsTransparency="True">

    <Border BorderBrush="#D4AF37" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="30">
            <TextBlock Text="AUTHENTICATION REQUIRED" FontSize="20" FontFamily="Georgia" 
                       Foreground="#D4AF37" HorizontalAlignment="Center"/>

            <TextBlock Text="To finalize your theatrical culinary journey, please sign in to your account." 
                       Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" 
                       Margin="0,20,0,30" FontFamily="Georgia" FontStyle="Italic"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="SIGN IN" Click="SignIn_Click" Width="120" Height="40" 
                        Background="#D4AF37" Foreground="Black" FontWeight="Bold" Margin="10,0" BorderThickness="0"/>

                <Button Content="NOT NOW" Click="Cancel_Click" Width="120" Height="40" 
                        Background="Transparent" Foreground="#666" BorderThickness="0" Margin="10,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>